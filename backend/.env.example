PORT=3001
NODE_ENV=production

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_64_char_random_hex_string

# Credenziali admin (create automaticamente al primo avvio se non esistono)
ADMIN_EMAIL=admin@valentinaandolfi.it
ADMIN_PASSWORD=change_me_before_first_start

# URL del frontend pubblico (per CORS e per il sitemap)
FRONTEND_URL=https://valentinaandolfi.it

# Percorsi
UPLOADS_DIR=./uploads
DB_PATH=./data/blog.db
