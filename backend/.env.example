PORT=3001
NODE_ENV=production

# Genera con: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=replace_me_with_a_64_char_random_hex_string

# Credenziali admin (create automaticamente al primo avvio se non esistono)
ADMIN_EMAIL=admin@valentinaandolfi.it
ADMIN_PASSWORD=change_me_before_first_start

# URL del frontend pubblico (per CORS e per il sitemap)
FRONTEND_URL=https://valentinaandolfi.it

# Percorsi
UPLOADS_DIR=./uploads
DB_PATH=./data/blog.db

# ============================================================
# SMTP (form contatti + email di conferma prenotazioni)
# ============================================================
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
CONTACT_TO=info@valentinaandolfi.it

# ============================================================
# STRIPE — pagamenti acconto prenotazioni
# ============================================================
# Chiave segreta dell'account Stripe (dashboard.stripe.com → Developers → API keys).
# Live key in produzione, test key in dev.
STRIPE_SECRET_KEY=sk_live_...

# Secret del webhook (dashboard.stripe.com → Developers → Webhooks → endpoint).
# L'endpoint da registrare è: https://valentinaandolfi.it/api/booking/webhook
# Eventi da abilitare: checkout.session.completed, checkout.session.expired
STRIPE_WEBHOOK_SECRET=whsec_...

# URL di ritorno dopo Stripe Checkout. {CHECKOUT_SESSION_ID} viene sostituito da Stripe.
# Se non impostati, il codice usa default su valentinaandolfi.it.
BOOKING_SUCCESS_URL=https://valentinaandolfi.it/prenota/conferma?session_id={CHECKOUT_SESSION_ID}
BOOKING_CANCEL_URL=https://valentinaandolfi.it/prenota

# ============================================================
# GOOGLE OAUTH — Calendar API (creazione eventi automatica)
# ============================================================
# Da Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# (tipo: Web application).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Redirect URI registrato nel client OAuth Google (DEVE corrispondere al pixel).
# In produzione l'unico ammesso è:
GOOGLE_OAUTH_REDIRECT=https://valentinaandolfi.it/api/booking/google/oauth/callback
